{% extends 'base.html.twig' %}

{% block title %}{% endblock %}

{% block body %}
<div class="container">
    <h2>{{ categories.name }}</h2>
    <div class="row">
        {% for category in categories.pizzas %}
            <div class="card">
                <h2 class="card-title">{{ category.name }}</h2>
                <div class="card-body">
                    <a href="{{ path('app_pizzas') }}" class="btn btn-primary">pizza bekijken</a>
                </div>
            </div>
        {% endfor %}
    </div>
</div>
{% endblock %}